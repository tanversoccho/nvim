# Edit this master template through :EditEditorConfigTemplate.
# :MakeEditorConfig copies it into a project; copies are independent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.{html,htm,css,scss,js,mjs,cjs,jsx,ts,tsx,json,jsonc,yaml,yml,lua,sql}]
indent_size = 2

[*.py]
indent_size = 4

[*.{ps1,psm1,psd1}]
indent_size = 4

[Makefile]
indent_style = tab
indent_size = tab
